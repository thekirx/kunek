# The isolated demo at /demo needs no configuration.
# Use a trusted HTTPS origin for live use (localhost HTTP is supported for local Supabase tests).
ONIRO_APP_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only Supabase sb_secret_ key (or SUPABASE_SERVICE_ROLE_KEY for a local/legacy stack).
SUPABASE_SECRET_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# Server-only Meta credentials. Never use a NEXT_PUBLIC_ prefix for these.
META_APP_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
META_GRAPH_API_VERSION=
# Exact HTTPS URL on ONIRO_APP_URL, ending in /api/meta/oauth/callback.
META_OAUTH_REDIRECT_URI=
META_OAUTH_STATE_SECRET=
META_PAGE_TOKEN_KEY=
# Optional configuration ID when using Facebook Login for Business.
META_LOGIN_CONFIG_ID=
